# -*- coding: utf-8 -*-
# vim: ft=yaml
---
alcali:
  # Formula target for the modernized application fork.
  version: 3008.2.0
  supported_osfingers:
    - Debian-13
    - Ubuntu-24.04

  deploy:
    # package:  install a published wheel from a Python package registry.
    #           The deployed artifact is then exactly the one CI built and
    #           released, and no source checkout is kept on the minion.
    # source:   clone the repository and install its requirements. Required
    #           for the legacy upstream revision, which predates the wheel.
    # docker:   run the published container image here under Compose. See the
    #           alcali:docker block below.
    # external: Alcali runs somewhere this formula does not manage. Nothing is
    #           deployed; only the alcali:salt_master wiring is applied, and
    #           alcali:salt_master:rest_auth:verify_url becomes required.
    method: package

    package:
      # The wheel is fetched by exact file URL from this registry, so no
      # index is consulted for Alcali itself.
      registry_url: https://forge.example.com/api/packages/alcali/pypi
      # Credentials for that registry. They are written to the deploy user's
      # netrc, never passed on a command line. A read-only token is enough.
      username: alcali-deploy
      password: REPLACE_WITH_A_READ_ONLY_REGISTRY_TOKEN
      # Defaults to alcali:version when null.
      version: null

    # Used by method: source only. The default is the public repository over
    # HTTPS, which needs neither identity nor known_host; this example shows
    # the private-over-SSH case instead, where both are required.
    repository: ssh://git@forge.example.com:8222/salt/alcali-modernized.git
    revision: 14fe53a19aacff688fdc98cffc43b665bb813baf    # tag v3008.2.0
    force_reset: false
    # A read-only deploy key. Ship it through the fileserver (0400,
    # root-owned) or point at a key already present on the minion.
    identity: salt://alcali/files/deploy_key
    # Pinned so the first clone cannot be answered by an unknown host key.
    known_host:
      name: forge.example.com
      port: 8222
      enc: ssh-ed25519
      fingerprint: SHA256:REPLACE_WITH_THE_SCANNED_HOST_KEY_FINGERPRINT
    directory: /opt/alcali
    code_directory: /opt/alcali/code
    virtualenv: /opt/alcali/venv
    user: alcali
    group: alcali
    shell: /usr/sbin/nologin
    python: python3

  # This is the same database used by the Salt master job/event returner.
  # Create it and load Salt's official returner schema before applying Alcali.
  database:
    backend: mysql             # mysql or postgresql
    # connector: psycopg2-binary   # avoids building the connector from source
    name: salt
    user: alcali
    password: REPLACE_WITH_A_LONG_RANDOM_PASSWORD
    host: 127.0.0.1
    port: 3306

  django:
    # Generate with: openssl rand -base64 48
    secret_key: REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
    allowed_hosts:
      - alcali.example.com
    debug: false
    # null for local Django users, ldap, or social.
    auth_backend: null

  salt_api:
    # Alcali's backend connects to this address. Keeping it on loopback is
    # preferred when Alcali and the Salt master share a host - but not for
    # deploy:method: docker, where loopback is the container rather than the
    # host. Use the hostname the salt-api certificate is issued for there.
    url: https://127.0.0.1:8080
    auth: rest
    master_minion_id: salt-master.example.com
    verify_tls: true
    # ca_bundle: /etc/ssl/certs/internal-ca.pem
    timeout: 30

  # Notification delivery. What fires and who hears about it is configured in
  # Alcali's own UI; this is the mail transport and the evaluation schedule.
  # A rule that only posts to a webhook needs none of the email settings.
  notifications:
    # Nothing is sent unless this timer runs.
    enabled: true
    # systemd OnCalendar. Alerts fire on a transition rather than a state, so
    # a frequent sweep does not mean frequent mail.
    schedule: '*:0/15'
    email:
      host: letter.example.com
      port: 25
      use_tls: false
      # user / password only if the relay requires authentication.
      from_address: alcali@example.com

  # Used by deploy:method: docker only.
  docker:
    # Pin a version. Defaults to registry/alcali:<alcali:version> when null.
    image: registry.example.com/alcali:3008.2.0
    registry: registry.example.com
    # Written to /root/.docker/config.json, never passed to `docker login`.
    registry_username: alcali-deploy
    registry_password: REPLACE_WITH_A_READ_ONLY_REGISTRY_TOKEN
    pull: true
    install_packages: true
    packages:
      - docker.io
      - docker-compose-v2
    directory: /opt/alcali
    compose_file: /opt/alcali/docker-compose.yml
    project_name: alcali
    # Publish behind a TLS reverse proxy, as with the systemd deployment.
    # This address also becomes the default salt-api ^url callback.
    publish_address: 127.0.0.1
    publish_port: 8000
    # Run MariaDB in the same Compose project. Off unless the master has no
    # returner database yet. When on, alcali:database:host must be an address
    # on this host - it is where the container publishes it and where the
    # master is told to connect.
    bundled_database: false
    database_image: mariadb:11.4
    database_root_password: null
    # CA the container must trust to reach salt-api. salt:// or an absolute
    # path on the minion; mounted read-only at ca_bundle_path.
    ca_bundle_source: null
    ca_bundle_path: /etc/alcali/tls/salt-ca.pem
    service: alcali
    start_timeout: 300

  features:
    ldap: false
    social: false

  # Additional variables are written verbatim to /opt/alcali/.env. Examples:
  environment: {}
  # Set additional values when required, for example:
  # environment:
  #   CSRF_TRUSTED_ORIGINS: https://alcali.example.com
  #   SESSION_COOKIE_SECURE: 'true'
  #   CSRF_COOKIE_SECURE: 'true'
  #   AUTH_LDAP_SERVER_URI: ldaps://ldap.example.com
  #   AUTH_LDAP_BIND_DN: cn=alcali,ou=services,dc=example,dc=com
  #   AUTH_LDAP_BIND_PASSWORD: REPLACE_ME
  #   AUTH_LDAP_USER_BASE_CN: ou=people,dc=example,dc=com
  #   AUTH_LDAP_USER_SEARCH_FILTER: '(uid=%(user)s)'
  #   AUTH_LDAP_REQUIRE_GROUP: cn=salt-admins,ou=groups,dc=example,dc=com
  #   AUTH_LDAP_START_TLS: 'false'
  #   SOCIAL_AUTH_GOOGLE_OAUTH2_KEY: example.apps.googleusercontent.com
  #   SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET: REPLACE_ME
  #   SOCIAL_AUTH_REDIRECT_URI: https://alcali.example.com
  #   SOCIAL_AUTH_GOOGLE_OAUTH2_WHITELISTED_DOMAINS: example.com

  # Normally empty: the modernized application owns its supported dependency
  # ranges. Use only for an intentional, tested emergency override.
  python_overrides: []

  gunicorn:
    # Bind locally and publish through an authenticated TLS reverse proxy.
    bind: 127.0.0.1
    port: 5000
    workers: 4
    timeout: 300

  service:
    name: alcali

  salt_master:
    # Enable only after reading README.md. This manages the master job cache,
    # event returner, salt-api, and eAuth configuration and restarts both
    # salt-master and salt-api when it changes.
    manage: false
    config_file: /etc/salt/master.d/alcali.conf
    master_service: salt-master
    api_service: salt-api
    returner: mysql            # mysql or postgres
    install_connector: true
    pip_bin: /opt/saltstack/salt/bin/pip3
    keep_jobs_seconds: 604800  # seven days; 0 keeps jobs indefinitely
    remove_on_clean: false

    api:
      host: 127.0.0.1
      port: 8080
      ssl_crt: /etc/salt/pki/api.crt
      ssl_key: /etc/salt/pki/api.key

    # Salt 3006 disables every netapi client unless explicitly enabled.
    # Keep this to the clients actually required by your Alcali users.
    netapi_clients:
      - local
      - local_async
      - runner
      - runner_async
      - wheel
      - wheel_async

    rest_auth:
      # The Salt master calls this endpoint to validate Alcali JWT tokens, so
      # the address must resolve and be routable *from the master*.
      #
      # Derived from the deployment when null: the gunicorn bind for
      # package/source, the published Compose address for docker. Required
      # for deploy:method: external, which has nothing to derive it from.
      verify_url: null
      users:
        admin:
          - '.*'
          - '@runner'
          - '@wheel'
          - '@jobs'
        # A narrower example account:
        operator:
          - 'test.*'
          - 'state.*'
          - '@jobs'
