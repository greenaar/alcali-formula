{#- Oneshot evaluation of Alcali's notification rules.

    Driven by alcali-notify.timer rather than run continuously: evaluating
    every rule walks the whole fleet, which has no business happening inside
    a web request.

    Context:
      alcali    full merged formula configuration
      manage    the management entry point, which differs between a source
                checkout (python manage.py) and an installed wheel (alcali)
#}
[Unit]
Description=Evaluate Alcali notification rules
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=ENV_PATH={{ directory }}
EnvironmentFile={{ directory }}/.env
WorkingDirectory={{ working_directory }}
User={{ user }}
Group={{ group }}
UMask=0027
ExecStart={{ manage }} notify
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
