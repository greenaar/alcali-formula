{#- Environment file for Alcali, shared by alcali.config (systemd deployment)
    and alcali.docker (Compose deployment).

    The two differ only in the values passed through the context, never in the
    set of variables written, so a new setting cannot be added to one
    deployment method and forgotten in the other.

    Context:
      alcali         full merged formula configuration
      db_host        database host as the application resolves it, which is
                     not alcali:database:host inside a container
      ca_bundle      SALT_CA_BUNDLE path as the application sees it, or null
      legacy_source  render the pre-fork variable names as well
#}
# Managed by Salt. Do not edit locally.
DB_BACKEND={{ alcali.database.backend|yaml_dquote }}
DB_NAME={{ alcali.database.name|yaml_dquote }}
DB_USER={{ alcali.database.user|yaml_dquote }}
DB_PASS={{ alcali.database.password|yaml_dquote }}
DB_HOST={{ db_host|yaml_dquote }}
DB_PORT={{ alcali.database.port|yaml_dquote }}
SECRET_KEY={{ alcali.django.secret_key|yaml_dquote }}
ALLOWED_HOSTS={{ alcali.django.allowed_hosts|join(' ')|yaml_dquote }}
DJANGO_DEBUG={{ alcali.django.debug|string|lower|yaml_dquote }}
MASTER_MINION_ID={{ alcali.salt_api.master_minion_id|yaml_dquote }}
SALT_URL={{ alcali.salt_api.url|yaml_dquote }}
SALT_AUTH={{ alcali.salt_api.auth|yaml_dquote }}
{% if verify_tls is not none -%}
SALT_VERIFY_TLS={{ verify_tls|string|lower|yaml_dquote }}
{% endif -%}
{% if legacy_source and verify_tls is not none -%}
# Used only by the currently pinned legacy revision.
SALT_VERIFY_SSL={{ verify_tls|string|lower|yaml_dquote }}
{% endif -%}
SALT_TIMEOUT={{ alcali.salt_api.timeout|yaml_dquote }}
{% if ca_bundle -%}
SALT_CA_BUNDLE={{ ca_bundle|yaml_dquote }}
{% endif -%}
{#- Mail transport for notification rules. Absent EMAIL_HOST leaves Django on
    its console backend, which prints rather than sends. #}
{% if alcali.notifications.email.host -%}
EMAIL_HOST={{ alcali.notifications.email.host|yaml_dquote }}
EMAIL_PORT={{ alcali.notifications.email.port|yaml_dquote }}
EMAIL_USE_TLS={{ alcali.notifications.email.use_tls|string|lower|yaml_dquote }}
EMAIL_USE_SSL={{ alcali.notifications.email.use_ssl|string|lower|yaml_dquote }}
{% if alcali.notifications.email.user -%}
EMAIL_HOST_USER={{ alcali.notifications.email.user|yaml_dquote }}
EMAIL_HOST_PASSWORD={{ alcali.notifications.email.password|yaml_dquote }}
{% endif -%}
{% endif -%}
DEFAULT_FROM_EMAIL={{ alcali.notifications.email.from_address|yaml_dquote }}
{% if alcali.django.auth_backend -%}
AUTH_BACKEND={{ alcali.django.auth_backend|yaml_dquote }}
{% endif -%}
{% for key, value in alcali.environment|dictsort %}
{{ key|upper }}={{ value|string|yaml_dquote }}
{% endfor -%}
