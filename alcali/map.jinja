# -*- coding: utf-8 -*-
# vim: ft=jinja

{%- set tplroot = tpldir.split('/')[0] %}
{%- import_yaml tplroot ~ "/defaults.yml" as default_settings %}
{%- set _config = salt['config.get'](tplroot, default={}) %}
{%- set config = salt['grains.filter_by'](
      default_settings,
      default=tplroot,
      merge=_config
    )
%}
{%- set alcali = config %}
